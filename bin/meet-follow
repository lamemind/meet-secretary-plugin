#!/usr/bin/env bash
set -uo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$plugin_dir/lib/meet-common.sh"

TAIL_SLEEP_SECONDS=0.25
READ_TIMEOUT_SECONDS=0.5
DIARY_SILENT_AFTER_MILLIS=90000
OWNER_CHECK_MILLIS=2000

usage() {
    cat <<'USAGE'
meet-follow — segue gli eventi di un meet scritti dallo script di pulizia (<stamp>.eventi.tsv) e
stampa una riga per evento. Pensato come comando del tool Monitor di Claude Code: ogni riga su stdout
e' una notifica, cioe' un turno del segretario.

  meet-follow [--meet S] [--dir D] [--from-line N] [--min-gap-seconds G] [--batch-seconds B]
      --meet S             stamp o .tsv del meet; senza, il meet in corso nella cartella dei meet
      --dir D              cartella dei meet, default quella di meet-recorder (config.properties)
      --from-line N        primo evento da stampare, 1-based; senza, quello dopo l'ultimo gia'
                           stampato, salvato in <stamp>.segnalibro-segui: un riarmo non ripete niente
      --min-gap-seconds G  fra due stampe passano almeno G secondi, default 3, perche' Monitor scarta
                           le notifiche troppo fitte
      --batch-seconds B    gli eventi tema e parola escono al piu' una volta ogni B secondi, default
                           60, raccolti per tema e per parola; nome e fine escono subito e si portano
                           dietro quelli in attesa

Righe stampate:
  #<n> <ora> nome: <voce> chiama il segretario, righe a-b
  #<n> <ora> tema <tema>, righe a-b [(k eventi)]
  #<n> <ora> parola «<parole>», righe a-b [(k eventi)]
  #<n> <ora> fine: meet pulito fino alla riga <a>
  meet-follow: <messaggio>      meet seguito, registratore muto
n e' il numero dell'evento nel file degli eventi. Esce dopo l'evento fine. Un meet-follow nuovo sullo
stesso meet prende il posto di quello vecchio, che esce senza stampare.
USAGE
}

say() {
    printf 'meet-follow: %s\n' "$*"
}

# Su Git Bash ogni $(...) e' un fork da decine di millisecondi: l'ora si legge da EPOCHREALTIME in una
# variabile, senza subshell, perche' il ciclo la chiede a ogni giro.
now=0
refresh_now() {
    local micros="${EPOCHREALTIME/./}"
    now=$(( micros / 1000 ))
}

# Alla scadenza Monitor uccide la shell che ha lanciato il comando, non i suoi figli: su Windows il
# follower resterebbe vivo coi suoi tail. Si ferma da se' quando quella shell non c'e' piu'.
launcher_pid=$PPID
exit_if_launcher_gone() {
    kill -0 "$launcher_pid" 2>/dev/null || exit 0
}

requested_meet=""
meet_dir=""
from_line=""
min_gap_seconds=3
batch_seconds=60

while [ $# -gt 0 ]; do
    case "$1" in
        --meet)            requested_meet="$2";  shift 2 ;;
        --dir)             meet_dir="$2";        shift 2 ;;
        --from-line)       from_line="$2";       shift 2 ;;
        --min-gap-seconds) min_gap_seconds="$2"; shift 2 ;;
        --batch-seconds)   batch_seconds="$2";   shift 2 ;;
        -h|--help)         usage; exit 0 ;;
        *)                 meet_die "opzione non riconosciuta: $1" ;;
    esac
done

[[ "$min_gap_seconds" =~ ^[0-9]+$ ]] || meet_die "--min-gap-seconds vuole un intero di secondi: $min_gap_seconds"
[[ "$batch_seconds" =~ ^[0-9]+$ ]] || meet_die "--batch-seconds vuole un intero di secondi: $batch_seconds"
meet_resolve "$requested_meet" "$meet_dir" || meet_die "$MEET_ERROR"

events_file="$MEET_BASE.eventi.tsv"
bookmark_file="$MEET_BASE.segnalibro-segui"
owner_file="$MEET_BASE.segui"

if [ -z "$from_line" ]; then
    saved="$(meet_bookmark_value "$bookmark_file" eventi 0)"
    [[ "$saved" =~ ^[0-9]+$ ]] || saved=0
    from_line=$(( saved + 1 ))
fi
[[ "$from_line" =~ ^[1-9][0-9]*$ ]] || meet_die "--from-line vuole un intero da 1 in su: $from_line"

# Un riarmo dopo l'evento fine non avrebbe piu' niente da aspettare.
if [ -f "$events_file" ]; then
    end_event="$(awk -F'\t' -v before="$from_line" 'NR < before && $2 == "fine" { print NR; exit }' "$events_file")"
    if [ -n "$end_event" ]; then
        printf 'meet-follow: il meet %s e'"'"' gia'"'"' finito, evento fine #%s\n' "$MEET_STAMP" "$end_event"
        exit 0
    fi
fi

# Dopo un /clear la skill riarma Monitor senza sapere se il Monitor di prima e' ancora vivo: due
# follower sullo stesso meet sveglierebbero il segretario due volte per evento. Vince l'ultimo: il
# file <stamp>.segui porta il suo gettone, e un follower che non lo ritrova esce.
owner_token="$$-${EPOCHREALTIME}"
meet_write_atomic "$owner_file" "$owner_token"$'\n'
next_owner_check=0
exit_unless_owner() {
    local current=""
    IFS= read -r current < "$owner_file" 2>/dev/null
    [ "$current" = "$owner_token" ] || exit 0
}

exit_if_replaced() {
    (( now >= next_owner_check )) || return
    next_owner_check=$(( now + OWNER_CHECK_MILLIS ))
    exit_unless_owner
}

min_gap_millis=$(( min_gap_seconds * 1000 ))
batch_millis=$(( batch_seconds * 1000 ))
line_number=$(( from_line - 1 ))
pending_through=$line_number
partial_event_line=""
immediate_lines=()
batch_keys=()
declare -A batch_from=() batch_to=() batch_count=() batch_time=() batch_last=()
last_print_millis=0
last_batch_print_millis=0
finished=0

save_bookmark() {
    meet_write_atomic "$bookmark_file" "eventi=$pending_through"$'\n'
}

range_text() {
    if [ "$1" = "$2" ]; then
        printf 'riga %s' "$1"
    else
        printf 'righe %s-%s' "$1" "$2"
    fi
}

# tema e parola si raccolgono per tema e per parole trovate: una notifica porta un tema una volta
# sola, con l'intervallo di righe di tutti i suoi eventi in attesa.
add_batched() {
    local key="$1" number="$2" time="$3" from="$4" to="$5"
    if [ -z "${batch_count[$key]:-}" ]; then
        batch_keys+=("$key")
        batch_from[$key]=$from
        batch_to[$key]=$to
        batch_count[$key]=1
    else
        local known_from="${batch_from[$key]}" known_to="${batch_to[$key]}" known_count="${batch_count[$key]}"
        [ "$from" -lt "$known_from" ] && batch_from[$key]=$from
        [ "$to" -gt "$known_to" ] && batch_to[$key]=$to
        batch_count[$key]=$(( known_count + 1 ))
    fi
    batch_time[$key]=$time
    batch_last[$key]=$number
}

format_batched() {
    local key="$1" kind="${1%%:*}" detail="${1#*:}" count="${batch_count[$1]}" line
    local range
    range="$(range_text "${batch_from[$key]}" "${batch_to[$key]}")"
    case "$kind" in
        tema)   printf -v line '#%s %s tema %s, %s' "${batch_last[$key]}" "${batch_time[$key]}" "$detail" "$range" ;;
        parola) printf -v line '#%s %s parola «%s», %s' "${batch_last[$key]}" "${batch_time[$key]}" "$detail" "$range" ;;
    esac
    (( count > 1 )) && line+=" ($count eventi)"
    printf '%s' "$line"
}

handle_event_line() {
    local raw="${1%$'\r'}"
    [ -n "$raw" ] || return
    line_number=$(( line_number + 1 ))
    pending_through=$line_number
    local time kind from to detail rest
    time="${raw%%$'\t'*}";  rest="${raw#*$'\t'}"
    kind="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    from="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    to="${rest%%$'\t'*}";   detail="${rest#*$'\t'}"
    [ "$detail" = "$rest" ] && [ "$to" = "$rest" ] && detail=""
    local line
    case "$kind" in
        nome)
            printf -v line '#%d %s nome: %s chiama il segretario, %s' "$line_number" "$time" "$detail" "$(range_text "$from" "$to")"
            immediate_lines+=("$line") ;;
        fine)
            printf -v line '#%d %s fine: meet pulito fino alla riga %s' "$line_number" "$time" "$to"
            immediate_lines+=("$line")
            finished=1 ;;
        tema|parola)
            add_batched "$kind:$detail" "$line_number" "$time" "$from" "$to" ;;
        *)
            printf -v line '#%d %s %s, %s: %s' "$line_number" "$time" "$kind" "$(range_text "$from" "$to")" "$detail"
            immediate_lines+=("$line") ;;
    esac
}

# Monitor scarta le notifiche che superano circa una ogni 2 s, e dopo 30 s di scarti si ferma: fra due
# stampe passa almeno min_gap, e tutto quello che e' in attesa esce con un printf solo, che Monitor
# consegna come una notifica. Le righe escono nell'ordine degli eventi, un tema raccolto al posto del
# suo ultimo evento.
print_pending() {
    local lines=("${immediate_lines[@]}") key printed_batch=0
    for key in "${batch_keys[@]}"; do
        lines+=("$(format_batched "$key")")
        printed_batch=1
    done
    (( ${#lines[@]} > 0 )) || return
    exit_unless_owner
    if (( ${#lines[@]} > 1 )); then
        printf '%s\n' "${lines[@]}" | sort -t ' ' -k1.2,1n
    else
        printf '%s\n' "${lines[@]}"
    fi
    immediate_lines=()
    batch_keys=()
    batch_from=(); batch_to=(); batch_count=(); batch_time=(); batch_last=()
    last_print_millis=$now
    (( printed_batch )) && last_batch_print_millis=$now
    save_bookmark
}

print_pending_if_due() {
    (( now - last_print_millis >= min_gap_millis )) || return
    if (( ${#immediate_lines[@]} > 0 )); then
        print_pending
    elif (( ${#batch_keys[@]} > 0 && now - last_batch_print_millis >= batch_millis )); then
        print_pending
    fi
}

# read -t che scade a meta' riga tiene il pezzo letto nella variabile e il read dopo riparte da li':
# il pezzo si conserva e si ricuce.
read_event_line() {
    local chunk="" status
    IFS= read -r -t "$READ_TIMEOUT_SECONDS" -u 3 chunk
    status=$?
    if (( status == 0 )); then
        handle_event_line "$partial_event_line$chunk"
        partial_event_line=""
        return 0
    fi
    partial_event_line+="$chunk"
    (( status > 128 )) && return 1
    say "la lettura del file degli eventi si e' interrotta: $events_file"
    exit 1
}

# Il diario del registratore dice quello che il file degli eventi non puo' dire: che il registratore
# e' caduto (nessuna riga per 90 s, mentre la riga stato arriva ogni 30). Dopo la sua riga fine il
# diario tace di diritto, e il meet finisce con l'evento fine della pulizia.
refresh_now
last_diary_line_millis=$now
diary_silence_reported=0
recorder_finished=0
meet_diary_has_end "$MEET_DIARY" && recorder_finished=1

drain_diary() {
    local diary_line rest
    while read -r -t 0 -u 4; do
        IFS= read -r -u 4 diary_line || break
        last_diary_line_millis=$now
        if (( diary_silence_reported )); then
            say "il diario del registratore e' ripartito"
            diary_silence_reported=0
        fi
        rest="${diary_line#*$'\t'}"
        [ "${rest%%$'\t'*}" = "fine" ] && recorder_finished=1
    done
}

report_diary_silence_if_due() {
    (( recorder_finished || diary_silence_reported )) && return
    local silent_millis=$(( now - last_diary_line_millis ))
    (( silent_millis >= DIARY_SILENT_AFTER_MILLIS )) || return
    say "il diario del registratore e' muto da $(( silent_millis / 1000 )) s: meet-recorder e' caduto o e' stato fermato?"
    diary_silence_reported=1
}

events_tail_pid=""
diary_tail_pid=""
stop_tails() {
    [ -n "$events_tail_pid" ] && kill "$events_tail_pid" 2>/dev/null
    [ -n "$diary_tail_pid" ] && kill "$diary_tail_pid" 2>/dev/null
}
trap stop_tails EXIT
trap 'exit 0' INT TERM HUP

exec 3< <(exec tail -n "+$from_line" -F -s "$TAIL_SLEEP_SECONDS" "$events_file" 2>/dev/null)
events_tail_pid=$!
exec 4< <(exec tail -n 0 -F -s "$TAIL_SLEEP_SECONDS" "$MEET_DIARY" 2>/dev/null)
diary_tail_pid=$!

# Su stderr: ogni riga su stdout e' un turno del segretario, e questa non chiede niente.
echo "meet-follow: segue gli eventi di $MEET_STAMP dall'evento $from_line" >&2

while true; do
    read_event_line
    refresh_now
    drain_diary
    if (( finished )); then
        while read_event_line; do :; done
        refresh_now
        while (( now - last_print_millis < min_gap_millis )); do
            sleep 0.2
            refresh_now
        done
        print_pending
        exit 0
    fi
    print_pending_if_due
    report_diary_silence_if_due
    exit_if_replaced
    exit_if_launcher_gone
done
